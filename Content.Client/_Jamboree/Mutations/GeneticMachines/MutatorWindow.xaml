<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'mutator-window-title'}"
               SetSize="400 260"
               MinSize="400 260">
    <BoxContainer Orientation="Vertical" Margin="6">
        <RichTextLabel Name="StatusLabel" HorizontalExpand="True" />
        <RichTextLabel Name="OccupantLabel" HorizontalExpand="True" Margin="0 6 0 0" />
        <RichTextLabel Name="AlreadyMutatedLabel" HorizontalExpand="True" Margin="0 4 0 0"
                       StyleClasses="LabelDanger"
                       Visible="False" />
        <Control MinSize="0 12" />
        <Button Name="ActivateButton"
                Access="Public"
                HorizontalAlignment="Stretch"
                Text="{Loc 'mutator-button-activate'}" />
        <Label Name="BusyLabel" Margin="0 8 0 0" Text="{Loc 'mutator-busy'}" Visible="False" />
        <ProgressBar Name="ProgressBar" Access="Public" Margin="0 4 0 0" HorizontalExpand="True"
                     MinValue="0" MaxValue="1" Value="0" Visible="False" />
    </BoxContainer>
</DefaultWindow>
