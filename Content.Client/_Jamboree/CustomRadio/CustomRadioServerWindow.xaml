<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'custom-radio-server-window-title'}"
               MinWidth="400">
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <Label Name="EmptyLabel" Text="{Loc 'custom-radio-server-window-empty'}" />
        <BoxContainer Name="ChannelList" Orientation="Vertical" SeparationOverride="2" />
        <BoxContainer Name="EditPanel" Orientation="Vertical" SeparationOverride="4" Visible="False">
            <Label Text="{Loc 'custom-key-window-name'}" />
            <LineEdit Name="NameEdit" />
            <Label Text="{Loc 'custom-key-window-prefix'}" />
            <LineEdit Name="KeyEdit" />
            <Label Text="{Loc 'custom-key-window-color'}" />
            <ColorSelectorSliders Name="ColorSelector" />
            <Label Name="ColorPreview" />
            <Button Name="SaveButton" Text="{Loc 'custom-radio-server-window-save'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>