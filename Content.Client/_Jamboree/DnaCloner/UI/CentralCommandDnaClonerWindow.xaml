<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="clr-namespace:Robust.Client.UserInterface.CustomControls;assembly=Robust.Client"
               Title="DNA Molecularsynthesis Console"
               SetWidth="400"
               SetHeight="500">
    <BoxContainer Orientation="Vertical" Margin="10">
        <Label Name="HeaderLabel" Text="Dead Personnel Records" HorizontalAlignment="Center" />
        <Label Name="StatusLabel" HorizontalAlignment="Center" />
        <Label Name="BiomassLabel" HorizontalAlignment="Center" />
        <PanelContainer StyleClasses="LowDivider" />
        <ScrollContainer Name="ListScroll" VerticalExpand="True">
            <BoxContainer Name="NameList" Orientation="Vertical" Margin="5" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
