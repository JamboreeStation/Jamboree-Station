ent-ActionMindSwapMutation = Mind Swap
  .desc = Swap minds with the target. Either can change back after 20 seconds.

ent-ActionElectrokinesisMutation = Electrokinesis
  .desc = Sends a bolt of lightning to the target, leaving them stunned and stuttering.

ent-ActionPyrokinesisMutation = Pyrokinesis
  .desc = Light a flammable target on fire.

ent-ActionMutantInvisibility = Invisibility
  .desc = Render yourself invisible to normal sight.

ent-ActionMutantInvisibilityUsed = Turn Off Invisibility
  .desc = Return to visibility, and receive a stun.

ent-ActionTeleprojection = Teleprojection
  .desc = Mentally project yourself to remotely observe things.