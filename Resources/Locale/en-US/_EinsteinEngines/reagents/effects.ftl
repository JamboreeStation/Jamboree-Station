reagent-effect-guidebook-chem-reroll-psionic =
    { $chance ->
        [1] Attempts
        *[other] attempt
    } to awaken psionic powers, consuming an available psionic reroll

reagent-effect-guidebook-chem-remove-psionic =
    { $chance ->
        [1] Removes
        *[other] remove
    } psionic powers, preventing the acquisition of new ones

reagent-effect-guidebook-chem-restorereroll-psionic =
    { $chance ->
        [1] Restores
        *[other] restore
    } an eligible psionic entity's ability to reroll its psionic powers

reagent-effect-guidebook-change-glimmer-reaction-effect =
    { $chance ->
        [1] Adjusts
        *[other] adjust
    } glimmer input by {NATURALFIXED($count, 2)} per unit, with a nonlinear effect on measured glimmer
